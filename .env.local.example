# Manuel — environment variables (names only; never commit real secrets).
# Copy to .env.local and fill in. All values are SERVER-SIDE only except NEXT_PUBLIC_*.

# ElevenLabs Agents — voice layer (mandated). Used by /api/signed-url.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Retrieval / structuring. Used by /api/resolve-procedure (server-side only).
# Gemini (gemini-3.6-flash) builds the step list; vision comes in Phase 2a.
CONTEXT_DEV_API_KEY=
GEMINI_API_KEY=

# Webhook tool base URL (non-secret). e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Escalation gag — the number the `escalate` client tool dials via tel: (non-secret).
# Defaults to +971508888888 in code if unset.
NEXT_PUBLIC_ADMIN_TEL=
